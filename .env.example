# Copy to .env and fill locally. Environment variables take precedence.
# The base URL must be the API root, usually ending in /v1, not /chat/completions.
# Use the URL and model identifier from your provider; no provider is selected by default.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Local loopback HTTP servers can omit the key if the server does not require auth.
LLM_TIMEOUT_SECONDS=30
AGENT_MAX_MODEL_CALLS=5
AGENT_MAX_TOOL_CALLS=8
SESSION_TTL_SECONDS=1800
SESSION_CAPACITY=128

# Optional vector retrieval (separate credentials; never copied from LLM automatically).
# Empty configuration uses explicitly labeled keyword_2gram fallback.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# Optional index/relevance_score-compatible /rerank endpoint; requires vector retrieval.
RERANKER_BASE_URL=
RERANKER_MODEL=
RERANKER_API_KEY=
RETRIEVAL_TIMEOUT_SECONDS=15
RETRIEVAL_TOP_N=30
RETRIEVAL_MIN_SIMILARITY=0.25
